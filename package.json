{
  "name": "hangyeol",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev -w @hangyeol/docs",
    "build": "npm run build -w @orderthan31/hangyeol-core && npm run generate -w @hangyeol/docs && npm run build -w @hangyeol/docs",
    "build:slice": "npm run build",
    "typecheck": "tsc -p packages/core/tsconfig.json && tsc -p apps/docs/tsconfig.json",
    "typecheck:slice": "npm run typecheck",
    "test": "npm run test:source -w @orderthan31/hangyeol-core && npm run test:code -w @hangyeol/docs",
    "test:slice": "npm run test",
    "lint:slice": "node scripts/lint-slice.mjs",
    "lint:design": "npm run lint:slice",
    "preview": "npm exec -w @hangyeol/docs -- vite preview --host 127.0.0.1"
  },
  "devDependencies": {
    "@shadcn/lint": "0.2.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.20.5",
    "@types/prismjs": "1.26.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@typescript-eslint/parser": "8.71.1",
    "@vitejs/plugin-react": "5.0.4",
    "eslint": "9.39.5",
    "jsdom": "26.1.0",
    "postcss": "8.5.28",
    "prettier": "3.6.2",
    "prismjs": "1.30.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "tailwindcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@tailwindcss/node": "4.3.3"
  },
  "workspaces": [
    "packages/core",
    "apps/docs"
  ]
}
